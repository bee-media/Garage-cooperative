<?xml version="1.0" encoding="utf-8"?>
<!-- ТОЛЬКО отладочная сборка: разрешён HTTP к серверу разработки.
     10.0.2.2 — компьютер при работе в эмуляторе. Если нужен свой тестовый сервер без TLS,
     добавьте его адрес ниже (в продакшене не используйте).
     В релизной сборке действует строгий main/res/xml/network_security_config.xml (только HTTPS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system"/></trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
