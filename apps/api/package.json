{
  "name": "@gsk/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:prod": "node --env-file=.env dist/cli/seed.js",
    "db:seed": "tsx --env-file=.env src/cli/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:security": "node test/integration/rbac-matrix.cjs && node test/integration/idor.cjs && node test/integration/audit4.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.1.1",
    "pdfmake": "^0.3.11",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "^3.6.4",
    "mailparser": "^3.9.39",
    "smtp-server": "^3.19.22",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
