# Скопируйте в .env и заполните. На test/prod все секреты свои, длинные и случайные.
NODE_ENV=development
PORT=3000
# Откуда разрешены запросы браузера (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://gsk_dev:gsk_dev_local@localhost:5432/gsk_rodnik?schema=public
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
# Каталог для загруженных файлов (вне webroot)
STORAGE_DIR=./storage
# Первый администратор (используется seed)
SEED_ADMIN_PHONE=9000000000
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PASSWORD=
# Адрес PWA (для ссылки в QR при выдаче пароля)
PWA_URL=http://localhost:5174
# Push. Ключи VAPID: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru
# Файл сервисного аккаунта Firebase (FCM, Android). Вне репозитория, права 600.
FCM_SERVICE_ACCOUNT_FILE=
# 1 = не отправлять, а писать в лог (для тестового стенда)
PUSH_DRY_RUN=0
# Ключ шифрования секретов 2FA в базе (минимум 32 символа). ЗАДАЙТЕ ДО первой настройки 2FA и не меняйте:
# при смене все сотрудники потеряют 2FA. Храните в сейфе вместе с остальными секретами.
TOTP_ENC_KEY=

# Почта (квитанции). Если SMTP_HOST пуст — письма не уходят, а сохраняются в STORAGE_DIR/mail-outbox как .eml
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ГСК «Родник» <no-reply@example.ru>"
