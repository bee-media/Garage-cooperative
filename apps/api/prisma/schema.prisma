generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Пользователи, роли, сессии ─────────

model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  isSystem     Boolean  @default(false)
  // доступ в веб-портал (админка); у жителей false
  portalAccess Boolean  @default(false)
  permissions  String[]
  users        User[]
}

model User {
  id               Int       @id @default(autoincrement())
  // Телефон хранится как 10 цифр: 9091112277
  phone            String    @unique
  email            String?
  fullName         String?
  passwordHash     String
  roleId           Int
  role             Role      @relation(fields: [roleId], references: [id])
  isBlocked        Boolean   @default(false)
  failedAttempts   Int       @default(0)
  lockedAt         DateTime?
  pushEnabled      Boolean   @default(true)
  consentAt        DateTime?
  consentVersion   String?
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  mustSetupTotp    Boolean   @default(false)
  totpLastStep     Int?      // последний принятый 30-секундный шаг: защита от повторного использования кода
  lastLoginAt      DateTime?
  lastDebtReminderAt DateTime?
  note             String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  garages          GarageOwner[]
  pushDevices      PushDevice[]
  meterReadings    MeterReading[]
  backupCodes      BackupCode[]
  ads              Ad[]

  @@index([deletedAt])
}

model Session {
  id          String    @id @default(uuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  // предыдущий refresh после ротации: в течение короткого окна (параллельные запросы вкладок) даёт только access,
  // позже — признак кражи токена, сессия отзывается
  prevRefreshHash String? @unique
  rotatedAt   DateTime?
  client      String    // web-admin | pwa | android
  deviceName  String?
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
}

model PushDevice {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   // fcm | webpush
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────── Гаражи ─────────

enum GarageStatus {
  ACTIVE
  ARCHIVED
}

model Garage {
  id             Int           @id @default(autoincrement())
  number         String        @unique
  areaM2         Decimal?      @db.Decimal(8, 2)
  buildYear      Int?
  notes          String?
  hasBenefit     Boolean       @default(false)
  benefitPercent Int           @default(0)
  status         GarageStatus  @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owners         GarageOwner[]
  charges        Charge[]
  payments       Payment[]
  readings       MeterReading[]
  ads            Ad[]

  @@index([status])
}

// История владельцев: запись открыта, пока toDate = null
model GarageOwner {
  id        Int       @id @default(autoincrement())
  garageId  Int
  garage    Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  fromDate  DateTime  @default(now())
  toDate    DateTime?

  @@index([garageId])
  @@index([userId])
}

// ───────── Финансы ─────────

enum ChargeType {
  ELECTRICITY
  MEMBERSHIP
  PENALTY
}

model Charge {
  id          Int        @id @default(autoincrement())
  garageId    Int
  garage      Garage     @relation(fields: [garageId], references: [id])
  type        ChargeType
  period      String?    // «2026-Q4», «2026», «2026-10»
  amount      Decimal    @db.Decimal(12, 2)
  description String?
  readingId   Int?       @unique
  reading     MeterReading? @relation(fields: [readingId], references: [id])
  createdById Int
  createdAt   DateTime   @default(now())
  voidedAt    DateTime?
  voidedById  Int?

  @@index([garageId, type])
}

model Payment {
  id           Int        @id @default(autoincrement())
  garageId     Int
  garage       Garage     @relation(fields: [garageId], references: [id])
  type         ChargeType
  amount       Decimal    @db.Decimal(12, 2)
  paidAt       DateTime   @default(now())
  method       String     @default("cash")
  comment      String?
  receivedById Int
  createdAt    DateTime   @default(now())
  voidedAt     DateTime?
  voidedById   Int?

  @@index([garageId, type])
}

// ───────── Показания счётчиков ─────────

enum ReadingStatus {
  PENDING
  ACCEPTED
}

model MeterReading {
  id           Int           @id @default(autoincrement())
  garageId     Int
  garage       Garage        @relation(fields: [garageId], references: [id])
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  value        Decimal       @db.Decimal(12, 1)
  takenAt      DateTime
  comment      String?
  status       ReadingStatus @default(PENDING)
  acceptedById Int?
  acceptedAt   DateTime?
  createdAt    DateTime      @default(now())

  photos       MeterPhoto[]
  charge       Charge?

  @@index([garageId, takenAt])
}

model MeterPhoto {
  id        Int          @id @default(autoincrement())
  readingId Int
  reading   MeterReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  fileId    String       @unique
  file      FileAsset    @relation(fields: [fileId], references: [id])
}

// ───────── Файлы ─────────

model FileAsset {
  id        String   @id @default(uuid())
  path      String
  mime      String
  size      Int
  ownerId   Int?
  kind      String   // meter | ad | news | apk
  createdAt DateTime @default(now())

  meterPhotos MeterPhoto[]
  adPhotos    AdPhoto[]
  newsPhotos  NewsPhoto[]

  // суточная квота загрузок пользователя
  @@index([ownerId, createdAt])
}

// ───────── Новости ─────────

enum NewsStatus {
  PUBLISHED
  HIDDEN
}

model News {
  id          Int        @id @default(autoincrement())
  title       String
  body        String
  pinned      Boolean    @default(false)
  status      NewsStatus @default(PUBLISHED)
  authorId    Int
  publishedAt DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reads       NewsRead[]
  photos      NewsPhoto[]

  @@index([status, publishedAt])
}

model NewsPhoto {
  id     Int       @id @default(autoincrement())
  newsId Int
  news   News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  fileId String    @unique
  file   FileAsset @relation(fields: [fileId], references: [id])
  sort   Int       @default(0)
}

model NewsRead {
  newsId Int
  news   News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId Int
  readAt DateTime @default(now())

  @@id([newsId, userId])
}

// ───────── Объявления ─────────

enum AdType {
  SALE
  RENT
}

enum AdStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model Ad {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  garageId     Int?
  garage       Garage?   @relation(fields: [garageId], references: [id])
  garageNumber String
  type         AdType
  price        Decimal   @db.Decimal(12, 2)
  description  String?
  status       AdStatus  @default(PENDING)
  rejectReason String?
  moderatedById Int?
  moderatedAt  DateTime?
  expiresAt    DateTime?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  photos       AdPhoto[]
  reports      AdReport[]

  @@index([status, createdAt])
}

model AdPhoto {
  id     Int       @id @default(autoincrement())
  adId   Int
  ad     Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  fileId String    @unique
  file   FileAsset @relation(fields: [fileId], references: [id])
  sort   Int       @default(0)
}

model AdReport {
  id        Int      @id @default(autoincrement())
  adId      Int
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId    Int
  reason    String
  createdAt DateTime @default(now())
}

// ───────── Расписание, контакты, релизы, настройки ─────────

model ScheduleEntry {
  id       Int     @id @default(autoincrement())
  weekday  Int     // 1..7, пн=1
  opensAt  String? // "10:00"
  closesAt String?
  isClosed Boolean @default(false)
  note     String?
}

model ScheduleException {
  id   Int      @id @default(autoincrement())
  date DateTime @db.Date
  note String
}

model Contact {
  id       Int    @id @default(autoincrement())
  position String
  fullName String
  phone    String
  sort     Int    @default(0)
}

model AppRelease {
  id          Int      @id @default(autoincrement())
  versionName String
  versionCode Int      @unique
  notes       String?
  fileId      String
  sha256      String   @default("")
  size        Int      @default(0)
  createdById Int
  createdAt   DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

// ───────── Аудит (только добавление) ─────────

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    Int?
  actorPhone String?
  action     String
  entity     String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?

  @@index([at])
  @@index([actorId])
  @@index([entity, entityId])
}

// ───────── Резервные коды 2FA (хранятся только в виде HMAC) ─────────

model BackupCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────── Карта ГСК ─────────

// Ряд боксов: отрезок от (x1,y1) до (x2,y2) делится на равные боксы; numbers[i] — номер гаража в i-м боксе
// (пустая строка — бокс без номера). Привязка к гаражу идёт по номеру, отдельной таблицы нет.
model MapRow {
  id        Int      @id @default(autoincrement())
  label     String?
  x1        Float
  y1        Float
  x2        Float
  y2        Float
  depth     Float    @default(24)
  numbers   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MarkStatus {
  OPEN
  CLOSED
}

// Пометка на карте («не работает свет» и т.п.)
model MapMark {
  id           Int        @id @default(autoincrement())
  x            Float
  y            Float
  category     String     // NO_LIGHT | DAMAGE | LEAK | TRASH | OTHER
  comment      String?
  fileId       String?    @unique
  garageNumber String?
  status       MarkStatus @default(OPEN)
  createdById  Int
  createdAt    DateTime   @default(now())
  closedById   Int?
  closedAt     DateTime?
  closeComment String?

  @@index([status])
}

// Опора освещения
model MapPole {
  id          Int      @id @default(autoincrement())
  x           Float
  y           Float
  number      String
  comment     String?
  fileId      String?  @unique
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Линия электропередачи на карте. points: [{x, y, poleId?}] — вершины ломаной; вершина с poleId следует за опорой
model MapLine {
  id          Int            @id @default(autoincrement())
  name        String?
  color       String         @default("#f2c261")
  status      String         @default("OK") // OK | CHECK | EMERGENCY | OFF
  points      Json
  comment     String?
  fileId      String?        @unique
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  events      MapLineEvent[]

  @@index([status])
}

// Журнал линии: создание, смена состояния, заметки
model MapLineEvent {
  id      Int      @id @default(autoincrement())
  lineId  Int
  line    MapLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  at      DateTime @default(now())
  userId  Int
  action  String   // CREATE | STATUS | NOTE
  status  String?  // состояние линии после события
  comment String?

  @@index([lineId, at])
}

// ───────── Почта и импорт ─────────

model MailLog {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now())
  toAddr    String
  subject   String
  kind      String   // receipt | payment-receipt | test
  status    String   // sent | failed | dry-run
  error     String?
  garageId  Int?
  paymentId Int?
  sentById  Int?

  @@index([at])
  @@index([garageId])
}

model ImportLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  kind     String   // garages | charges | payments
  fileName String?
  fileHash String
  userId   Int
  summary  Json

  @@index([kind, fileHash])
}
