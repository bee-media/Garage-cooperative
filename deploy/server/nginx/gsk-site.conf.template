# /etc/nginx/sites-available/gsk-@@SITE@@ — @@SITE_TITLE@@
# Слушает только внутренний порт: наружу сайт выставляет Nginx Proxy Manager (TLS, домен).
server {
    listen @@LISTEN_ADDR@@:@@PORT@@;
    server_name _;

    # Редиректы nginx (например /api -> /api/) без порта: наружу сайт смотрит через Nginx Proxy Manager на 443,
    # а внутренний порт (8081/8082) клиентам показывать нельзя
    absolute_redirect off;
    port_in_redirect off;

    root /opt/gsk/current/apps/@@SITE@@/dist;
    index index.html;

    # Максимальный размер загрузки (фото; для портала — ещё и APK)
    client_max_body_size @@MAX_BODY@@;

    # Не раскрываем служебные файлы
    location ~ /\. { deny all; }

    # API — на Node.js. Реальный адрес клиента и схему (https) передаёт Nginx Proxy Manager
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Ответы API содержат личные данные — не кэшируем
        add_header Cache-Control "no-store" always;
        include snippets/gsk-security.conf;
    }

    # Файлы сборки с хэшем в имени можно кэшировать на год
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include snippets/gsk-security.conf;
        try_files $uri =404;
    }

    # Service worker и манифест должны проверяться на каждый запуск
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        include snippets/gsk-security.conf;
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache" always;
        include snippets/gsk-security.conf;
        try_files $uri =404;
    }

    # Остальное — одностраничное приложение
    location / {
        add_header Cache-Control "no-cache" always;
        include snippets/gsk-security.conf;
        try_files $uri $uri/ /index.html;
    }
}
