# /etc/gsk/api.env — окружение API. Права: 640, владелец root:gsk. НЕ коммитить, не пересылать.
# Значения вида @@NAME@@ подставляет deploy/server/setup.sh.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Перед API две прокси: Nginx Proxy Manager и локальный nginx
TRUST_PROXY_HOPS=2

# Откуда браузерам разрешены запросы. https://localhost — Android-приложение
CORS_ORIGINS=https://@@APP_DOMAIN@@,https://@@ADMIN_DOMAIN@@,https://localhost
# Адрес PWA (ссылка в QR при выдаче пароля)
PWA_URL=https://@@APP_DOMAIN@@

DATABASE_URL=postgresql://gsk:@@DB_PASSWORD@@@127.0.0.1:5432/@@DB_NAME@@?schema=public

JWT_ACCESS_SECRET=@@JWT_SECRET@@
# Ключ шифрования секретов 2FA в базе. НЕ МЕНЯТЬ после первой настройки 2FA (иначе у всех сотрудников 2FA перестанет работать).
# Хранить в сейфе вместе с остальными секретами.
TOTP_ENC_KEY=@@TOTP_KEY@@
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Загруженные фото и файлы (вне каталога приложения, включается в бэкап)
STORAGE_DIR=/var/lib/gsk/storage

# Push. На ТЕСТОВОМ сервере PUSH_DRY_RUN=1: уведомления не отправляются, а пишутся в журнал
PUSH_DRY_RUN=@@PUSH_DRY_RUN@@
VAPID_PUBLIC_KEY=@@VAPID_PUBLIC@@
VAPID_PRIVATE_KEY=@@VAPID_PRIVATE@@
VAPID_SUBJECT=mailto:@@ADMIN_EMAIL@@
# Ключ сервисного аккаунта Firebase (для Android). Положите файл сюда и раскомментируйте:
# FCM_SERVICE_ACCOUNT_FILE=/etc/gsk/fcm-service-account.json

# Первый администратор (используется ОДИН раз командой seed; после — удалить SEED_ADMIN_PASSWORD)
SEED_ADMIN_PHONE=@@ADMIN_PHONE@@
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PASSWORD=@@ADMIN_PASSWORD@@

# Почта для квитанций. Пустой SMTP_HOST = тестовый режим (письма пишутся в файлы, не отправляются)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ГСК «Родник» <no-reply@@@APP_DOMAIN@@>"
